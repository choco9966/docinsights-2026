{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choco9966/docinsights-2026/schemas/docsem-ocr-v1.schema.json",
  "title": "DocSem OCR record for Qwen",
  "type": "object",
  "required": [
    "schema_version",
    "instance_id",
    "user_query",
    "blocks",
    "engine",
    "provenance",
    "timing",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "user_query": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    },
    "timing": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "error_kind": {
      "enum": [
        "timeout",
        "file_not_found",
        "subprocess_error",
        "validation_error",
        "os_error",
        "runtime_error",
        "unknown_error"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error",
          "error_kind"
        ],
        "properties": {
          "blocks": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "pages"
        ],
        "properties": {
          "blocks": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "error_kind"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "required": [
        "page_number",
        "width",
        "height",
        "coordinate_system"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "coordinate_system": {
          "const": "pixel_top_left"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "block_id",
        "text",
        "page_numbers",
        "lines"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "text": {
          "type": "string"
        },
        "page_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      },
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "required": [
        "page_number",
        "text",
        "bbox",
        "confidence",
        "confidence_kind"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "oneOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
